# Consistent text files and binary Simulink/MATLAB artifacts.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.txt text eol=lf
*.m text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.prj text eol=lf
*.slx binary
*.mat binary
*.png binary
# The complete golden bundle is hash-pinned, including its text files.
/Data/Golden/** -text !eol whitespace=cr-at-eol
